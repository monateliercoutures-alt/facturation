# Base de données Neon : copiez la chaîne de connexion « pooled » du tableau de bord Neon.
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/factureci?sslmode=require"

# Secret des sessions. Générez-le avec : npx auth secret   (ou : openssl rand -base64 33)
AUTH_SECRET=""
# Nécessaire avec « npm start » hors de Vercel.
AUTH_TRUST_HOST=true

# Numéros administrateurs, séparés par des virgules (formats acceptés : 0700000000, +2250700000000).
ADMIN_PHONES="0700000000"

# Liens de paiement Wave des abonnements (utilisés au Prompt 4).
WAVE_LINK_PRO="https://pay.wave.com/m/..."
WAVE_LINK_BUSINESS="https://pay.wave.com/m/..."

# Adresse publique de l'application (sans / final).
APP_URL="http://localhost:3000"

# Compte admin créé par « npm run db:seed » (mot de passe de 8 caractères minimum).
SEED_ADMIN_PHONE="0700000000"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrateur"
